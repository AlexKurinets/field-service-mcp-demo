{
  "name": "field-service-mcp-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Runnable rebuild of a multi-tenant field-service MCP server: split read and draft-only servers, tenant from a signed run token, and an approval gate bound to the exact payload.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --no-warnings --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "demo": "npm run build && node --no-warnings dist/src/demo.js",
    "gateway": "npm run build && node --no-warnings dist/src/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
